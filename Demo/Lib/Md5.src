// MD5 (RFC 1321) at build time: u32 wraps and shifts logically, so the rounds are the spec verbatim.

const i32 Md5Len = 16;

//Rotate left. The two shifted halves occupy disjoint bit ranges, so `|` merges them without carry.
#build u32 Md5_Rotl(u32 x, i32 n)
{
	return (x << n) | (x >> (32 - n));
}

//The per-round constants, floor(abs(sin(i + 1)) * 2^32); a List<u32>, a `u32[]` one crashing the compiler.
#build List<u32> Md5_K()
{
	List<u32> k = [
		0xd76aa478:u32, 0xe8c7b756:u32, 0x242070db:u32, 0xc1bdceee:u32,
		0xf57c0faf:u32, 0x4787c62a:u32, 0xa8304613:u32, 0xfd469501:u32,
		0x698098d8:u32, 0x8b44f7af:u32, 0xffff5bb1:u32, 0x895cd7be:u32,
		0x6b901122:u32, 0xfd987193:u32, 0xa679438e:u32, 0x49b40821:u32,

		0xf61e2562:u32, 0xc040b340:u32, 0x265e5a51:u32, 0xe9b6c7aa:u32,
		0xd62f105d:u32, 0x02441453:u32, 0xd8a1e681:u32, 0xe7d3fbc8:u32,
		0x21e1cde6:u32, 0xc33707d6:u32, 0xf4d50d87:u32, 0x455a14ed:u32,
		0xa9e3e905:u32, 0xfcefa3f8:u32, 0x676f02d9:u32, 0x8d2a4c8a:u32,

		0xfffa3942:u32, 0x8771f681:u32, 0x6d9d6122:u32, 0xfde5380c:u32,
		0xa4beea44:u32, 0x4bdecfa9:u32, 0xf6bb4b60:u32, 0xbebfbc70:u32,
		0x289b7ec6:u32, 0xeaa127fa:u32, 0xd4ef3085:u32, 0x04881d05:u32,
		0xd9d4d039:u32, 0xe6db99e5:u32, 0x1fa27cf8:u32, 0xc4ac5665:u32,

		0xf4292244:u32, 0x432aff97:u32, 0xab9423a7:u32, 0xfc93a039:u32,
		0x655b59c3:u32, 0x8f0ccc92:u32, 0xffeff47d:u32, 0x85845dd1:u32,
		0x6fa87e4f:u32, 0xfe2ce6e0:u32, 0xa3014314:u32, 0x4e0811a1:u32,
		0xf7537e82:u32, 0xbd3af235:u32, 0x2ad7d2bb:u32, 0xeb86d391:u32
	]:List<u32>;
	return k;
}

//Append a u32 to a byte list, least significant byte first.
#build void Md5_AddLe(List<u8> out, u32 w)
{
	out.Add(cast<u8>(w));
	out.Add(cast<u8>(w >> 8));
	out.Add(cast<u8>(w >> 16));
	out.Add(cast<u8>(w >> 24));
}

//The MD5 digest of `buffer`, 16 bytes.
#build u8[16] Calculate(ConstSpan<u8> buffer)
{
	u32[] K = Md5_K();

	//Per-round rotate amounts, four groups of sixteen.
	i32[] S = [
		7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
		5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
		4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
		6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
	]:i32;

	//Pad to a multiple of 64: a 0x80 byte, zeros to 56 mod 64, then the length in BITS, little-endian.
	u32 count = 0:u32;
	List<u8> msg = List::New<u8>();
	for (const u8 b in buffer)
	{
		msg.Add(b);
		count = count + 1:u32;
	}

	msg.Add(128:u8);
	while (msg.Length % 64 != 56)
	{
		msg.Add(0:u8);
	}

	//bits = count * 8, as two little-endian words.
	Md5_AddLe(msg, count << 3);
	Md5_AddLe(msg, count >> 29);

	u32 a0 = 0x67452301:u32;
	u32 b0 = 0xefcdab89:u32;
	u32 c0 = 0x98badcfe:u32;
	u32 d0 = 0x10325476:u32;

	i32 chunks = msg.Length / 64;
	for (i32 chunk = 0; chunk < chunks; chunk++)
	{
		i32 off = chunk * 64;

		//The chunk as 16 little-endian u32 words.
		List<u32> M = List::New<u32>();
		for (i32 j = 0; j < 16; j++)
		{
			i32 p = off + j * 4;
			u32 w = cast<u32>(msg[p])
				| (cast<u32>(msg[p + 1]) << 8)
				| (cast<u32>(msg[p + 2]) << 16)
				| (cast<u32>(msg[p + 3]) << 24);
			M.Add(w);
		}

		u32 a = a0;
		u32 b = b0;
		u32 c = c0;
		u32 d = d0;

		for (i32 i = 0; i < 64; i++)
		{
			u32 f = 0:u32;
			i32 g = 0;

			if (i < 16)
			{
				f = (b & c) | (~b & d);
				g = i;
			}
			if (i >= 16 && i < 32)
			{
				f = (d & b) | (~d & c);
				g = (5 * i + 1) % 16;
			}
			if (i >= 32 && i < 48)
			{
				f = b ^ c ^ d;
				g = (3 * i + 5) % 16;
			}
			if (i >= 48)
			{
				f = c ^ (b | ~d);
				g = (7 * i) % 16;
			}

			u32 rotated = Md5_Rotl(f + a + K[i] + M[g], S[i]);
			a = d;
			d = c;
			c = b;
			b = b + rotated;
		}

		a0 = a0 + a;
		b0 = b0 + b;
		c0 = c0 + c;
		d0 = d0 + d;
	}

	List<u8> digest = List::New<u8>();
	Md5_AddLe(digest, a0);
	Md5_AddLe(digest, b0);
	Md5_AddLe(digest, c0);
	Md5_AddLe(digest, d0);
	return digest.ToArray();
}

// ---- self-test ----------------------------------------------------------------------------
// RFC 1321's vectors, plus a 62-byte input whose padding pushes it past 64 and into a second chunk.
#build str Md5_Hex(const Span<u8> data)
{
	return bytes_hexstr(Calculate(data));
}

#build bool Md5_SelfTest()
{
	List<u8> none = List::New<u8>();
	#assert(Md5_Hex(none.ToArray()) == "D41D8CD98F00B204E9800998ECF8427E", "MD5 of the empty input");

	u8[1] a;
	pack_str(a, 0:u32, "a");
	#assert(Md5_Hex(a) == "0CC175B9C0F1B6A831C399E269772661", "MD5 of \"a\"");

	u8[3] abc;
	pack_str(abc, 0:u32, "abc");
	#assert(Md5_Hex(abc) == "900150983CD24FB0D6963F7D28E17F72", "MD5 of \"abc\"");

	u8[14] digest;
	pack_str(digest, 0:u32, "message digest");
	#assert(Md5_Hex(digest) == "F96B697D7CB7938D525A2F31AAF161D0", "MD5 of \"message digest\"");

	u8[26] alpha;
	pack_str(alpha, 0:u32, "abcdefghijklmnopqrstuvwxyz");
	#assert(Md5_Hex(alpha) == "C3FCD3D76192E4007DFB496CCA67E13B", "MD5 of the lowercase alphabet");

	//62 bytes: padding pushes this past 64, so Calculate runs two chunks.
	u8[62] alnum;
	pack_str(alnum, 0:u32, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789");
	#assert(Md5_Hex(alnum) == "D174AB98D277D9F5A5611C2C9F419D9F", "MD5 across two chunks");

	u8[43] fox;
	pack_str(fox, 0:u32, "The quick brown fox jumps over the lazy dog");
	#assert(Md5_Hex(fox) == "9E107D9D372BB6826BD81D3542A419D6", "MD5 of the pangram");

	return true;
}

#test Md5_SelfTest "MD5 vectors"
