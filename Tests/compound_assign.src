void test()
{
	i32 x = 10;
	x += 5;
	x -= 3;
	x *= 2;
	x /= 4;
	x %= 5;
	WriteLine("x=" + to_str(x));
	i32[] a = [1, 2, 3, 4]:i32;
	a[0] += 10;
	a[2] *= 3;
	i32 s = 0;
	for (i32 i = 0; i < a.Length; i++)
	{
		s += a[i];
	}
	WriteLine("s=" + to_str(s));
}

i32 main()
{
	#run test();
	test();
	return 0;
}
