// A subscript peels one rank per index, so more indices than ranks is reported here.
struct Inner { i32[2] row; }

void Source(#param str name, #output Inner out @ "wide")
{
	out.row[0] = 1;
}

void Show(#param str name)
{
	#run
	{
		const Port p = Port::In(Type::Of<Inner>(), "wide");
		#insert { WriteLine(to_str(${Port::Field(p, ".row[0,1]")})); }
	}
}

i32 main()
{
	#run
	{
		Function[] funcs = [
			#create Source(name = "src"),
			#create Show(name = "show")
		]:Function;
		Solver solver = Solver::New(funcs);
		Solver::Solve(solver);
		#insert Solver::Struct(solver);
	}

	return 0;
}
