// `#create` names its template by hand, and a template is out of the symbol table by binding time,
// so the name is checked where the registry is: build time, when the block is asked for.
void Counter(#param str name, #state i32 c, #output i32 count @ $"{name}_count")
{
	count = c;
	c = c + 1;
}

i32 main()
{
	#run
	{
		Function[] blocks = [ #create Countr(name = "a") ]:Function;
		Solver solver = Solver::New(blocks);
		Solver::Solve(solver);
	}
	return 0;
}
