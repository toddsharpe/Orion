// A copy is given only arguments its template declares.
void Counter(#param str name, #param i32 step, #state i32 n, #output i32 out @ "out")
{
	n = n + step;
	out = n;
}

i32 main()
{
	#run
	{
		Block up = #block Counter(name = "up", step = 3);
		Block wider = up.With(${ stride = 2 });
	}
	return 0;
}
