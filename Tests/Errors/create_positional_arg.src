// A #param is picked by name. Specialization erases the #param list, so a position has nothing to
// match against, and `#create` says so where the argument was written.
void Counter(#param str name, #param i32 step, #output i32 count @ $"{name}_count")
{
	count = step;
}

i32 main()
{
	#run
	{
		Function[] blocks = [ #create Counter("a", 1) ]:Function;
		Solver solver = Solver::New(blocks);
		Solver::Solve(solver);
	}
	return 0;
}
