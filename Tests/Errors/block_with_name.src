// A copy keeps its name: renaming one would lose the block a list finds by it.
void Counter(#param str name, #param i32 step, #state i32 n, #output i32 out @ "out")
{
	n = n + step;
	out = n;
}

i32 main()
{
	#run
	{
		Block up = #block Counter(name = "up", step = 3);
		Block other = up.With(${ name = "other" });
	}
	return 0;
}
