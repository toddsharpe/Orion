// A path is walked against the port's type, so a field it does not declare is reported here.
struct Inner { i32 tag; }

void Source(#param str name, #output Inner out @ "wide")
{
	out.tag = 1;
}

void Show(#param str name)
{
	#run
	{
		const Port p = Port::In(Type::Of<Inner>(), "wide");
		#insert { WriteLine(to_str(${Port::Field(p, ".nope")})); }
	}
}

i32 main()
{
	#run
	{
		Function[] funcs = [
			#create Source(name = "src"),
			#create Show(name = "show")
		]:Function;
		Solver solver = Solver::New(funcs);
		Solver::Solve(solver);
		#insert Solver::Struct(solver);
	}

	return 0;
}
