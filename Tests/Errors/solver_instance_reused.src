// A block is named for its instance, so two blocks cannot share one.
void Gain(#param str name, #param i32 n, #output i32 y @ $"{name}_out")
{
	y = n;
}

i32 main()
{
	#run
	{
		Block[] blocks = [ #block Gain(name = "g", n = 1), #block Gain(name = "g", n = 2) ]:Block;
		Solver solver = Solver::New(blocks);
		Solver::Solve(solver);
	}
	return 0;
}
