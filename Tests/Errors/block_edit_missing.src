// An edit naming a block the list does not hold fails the build, naming what it does hold.
void Counter(#param str name, #param i32 step, #state i32 n, #output i32 out @ $"{name}_out")
{
	n = n + step;
	out = n;
}

i32 main()
{
	#run
	{
		const List<Block> app = [ #block Counter(name = "a", step = 1), #block Counter(name = "b", step = 2) ]:List<Block>;
		const List<Block> sim = app.Remove("boardin");
	}
	return 0;
}
