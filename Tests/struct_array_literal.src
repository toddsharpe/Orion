// A fixed-size array of structs, written as the literal it is: the count is part of the vehicle.
struct Fin
{
	f32 area;
	i32 index;
}

// The constant form a config states, and the array-typed suffix that writes the count out.
const Fin[2] Pair = [Fin{ area = 1.5:f32, index = 0 }, Fin{ area = 2.5:f32, index = 1 }]:Fin;

Fin[3] layout()
{
	return [Fin{ area = 1.0:f32, index = 10 }, Fin{ area = 2.0:f32, index = 11 }, Fin{ area = 3.0:f32, index = 12 }]:Fin[3];
}

f32 total(const Fin[2] fins)
{
	return fins[0].area + fins[1].area;
}

i32 main()
{
	WriteLine("pair = " + to_str(total(Pair)));

	Fin[3] fins = layout();
	f32 sum = 0.0:f32;
	for (i32 i = 0; i < fins.Length; i++)
	{
		sum = sum + fins[i].area;
	}
	WriteLine("sum = " + to_str(sum) + " last = " + to_str(fins[2].index));

	return 0;
}
