// A #run escape emits its code where it is written, so this block runs A, B, C, D, E in order.
void Src(#param str name, #state i32 t = 0, #output i32 v @ $"{name}_out")
{
	v = t;
	t = t + 1;
}

void Mix(#param str name, #param str source,
	#input i32 x @ source, #output i32 y @ $"{name}_out")
{
	WriteLine("A static, before the first escape");
	y = x + 1;

	#run {
		#insert { WriteLine("B escape one, in place"); }
	}

	WriteLine("C static, between the escapes");

	#run {
		#insert { WriteLine("D escape two, in place"); }
	}

	WriteLine("E static, after the last escape");
}

i32 main()
{
	#run
	{
		Function[] blocks = [ #create Src(name = "s"), #create Mix(name = "m", source = "s_out") ]:Function;
		Solver solver = Solver::New(blocks);
		Solver::Solve(solver);

		#insert Solver::Struct(solver);
		#insert { if (solver_init(state) == false) { return -1; } }
		#insert {
			for (i32 i = 0; i < 2; i++)
			{
				WriteLine("-- cycle " + to_str(i) + " --");
				solver_cycle(state);
			}
		}
	}
	return 0;
}
