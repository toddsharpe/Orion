// `..rest` stores rest's elements in place in an array literal. The source is a flat array whose type counts them:
// read once, from where it is stored, or folded in when it is a constant. A file-scope constant made of constants
// folds whole, length and all.

struct Fin
{
	f32 area;
	i32 index;
}

struct Frame
{
	u8[2] header;
}

const u8[2] HEADER = [0x7E:u8, 0x10:u8]:u8;
const u8[] FRAME = [..HEADER, 0x01:u8, ..HEADER]:u8;
const Fin[1] ONE = [Fin{ area = 1.5:f32, index = 0 }]:Fin;

i32[2] pair(i32 a)
{
	return [a, a + 1]:i32;
}

i32 total(i32[7] xs)
{
	i32 sum = 0;
	for (i32 i = 0; i < xs.Length; i++)
	{
		sum = sum + xs[i];
	}
	return sum;
}

str show(ConstSpan<i32> xs)
{
	str s = to_str(xs[0]);
	for (i32 i = 1; i < xs.Length; i++)
	{
		s = s + " " + to_str(xs[i]);
	}
	return s;
}

i32 main()
{
	// A local and a call's result, between single elements.
	i32[2] lo = [1, 2]:i32;
	i32[] all = [0, ..lo, ..pair(10), 99]:i32;
	WriteLine(show(all));
	WriteLine(to_str(total([..lo, ..lo, ..pair(3), 4]:i32)));

	// A struct's array field is a source like any other.
	Frame f = Frame{ header = [0x7E:u8, 0x20:u8]:u8 };
	u8[] bytes = [..f.header, 3:u8]:u8;
	WriteLine(to_str(bytes.Length) + " " + to_str(bytes[1]) + " " + to_str(bytes[2]));

	// A constant made of constants is one, so its length and elements are known at compile time.
	WriteLine(to_str(FRAME.Length) + " " + to_str(FRAME[2]) + " " + to_str(FRAME[3]));

	// Struct elements are copies: changing one changes neither the constant nor its other copy.
	Fin[] fins = [..ONE, ..ONE, Fin{ area = 2.5:f32, index = 2 }]:Fin;
	fins[0].index = 7;
	WriteLine(to_str(fins.Length) + " " + to_str(fins[0].index) + " " + to_str(fins[1].index) + " " + to_str(ONE[0].index) + " " + to_str(fins[2].area));

	// A 2-D literal fills row-major, so each spread here is a row.
	i32[2,2] grid = [..lo, ..pair(5)]:i32[2,2];
	WriteLine(to_str(grid[0,1]) + " " + to_str(grid[1,0]));

	// The literal is built apart from the variable it is assigned to, so the second spread still reads the old quad[0].
	i32[4] quad = [1, 2, 3, 4]:i32;
	quad = [..pair(quad[3]), ..pair(quad[0])]:i32;
	WriteLine(show(quad));
	return 0;
}
