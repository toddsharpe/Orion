// One `#insert` for both: braces make a fragment, anything else is an expression -- str or Code.
i32 main()
{
	i32 x = 0;

	#run
	{
		#insert $"WriteLine(\"from text\");";

		Code c = #code { WriteLine("from a fragment"); };
		#insert c;

		// The `;` terminates the #insert, so a string carries its own.
		str s = "x = 41;";
		#insert s;
	}

	WriteLine("x = " + to_str(x + 1));
	return 0;
}
