void print(ConstSpan<i32> array)
{
	for (i32 i = 0; i < array.Length; i++)
	{
		i32 item = array[i];
		WriteLine(to_str(array[i]));
	}
}

i32 inc(i32 i)
{
	if (i == 0)
	{
		return -1;
	}

	i++;
	return i;
}

void test()
{
	print([1, 2, 3, 4]:i32);

	i32 add = inc(0);
	WriteLine(to_str(add));
}

i32 main()
{
	#run test();
	test();

	return 0;
}
