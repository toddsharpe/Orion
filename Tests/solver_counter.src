// Solver feedback: a stateful counter block (#state) reused twice, run over the solver's
// cyclic executive. Each instance keeps its own state and advances independently per cycle.

void Counter(
	#param str name,
	#param i32 step = 1,
	#state i32 c = 0,
	#output i32 count @ $"{name}_count"
)
{
	count = c;
	c = c + step;
}

i32 main()
{
	#run
	{
		Function[] funcs = [
			#create Counter(name = "a"),
			#create Counter(name = "b", step = 10)
		]:Function;
		Solver solver = Solver::New(funcs);
		Solver::Solve(solver);

		#insert Solver::Struct(solver);
		#insert { if (solver_init(state) == false) { return -1; } }
		#insert {
			for (i32 i = 0; i < 4; i++)
			{
				solver_cycle(state);
				${Solver::ViewState(solver)};
			}
		}
	}

	return 0;
}
