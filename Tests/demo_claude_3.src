Acc acc_0(ConstSpan<i32> data)
{
	Acc a = Acc{};
	a.Sum = 0;
	a.Count = 0;
	a.Max = 0;
	for (i32 i = 0; i < data.Length; i++)
	{
		i32 v = data[i] * 3;
		a.Sum = a.Sum + v;
		a.Count = a.Count + 1;
		if (v > a.Max)
		{
			a.Max = v;
		}
	}
	return a;
}

