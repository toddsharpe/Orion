/*
 * demo_claude_3 -- an auto-generated 10,000+ line Orion program.
 *
 * A deliberately huge stress test that pushes the whole language: hundreds of
 * generated arithmetic pipelines, array reducers, predicates, recursive
 * functions, enum classifiers and struct processors, a hand-written core
 * (factorial/fib/gcd/primes, a bytecode VM, higher-order combinators, struct
 * arrays) and a self-checking harness in main().
 */

enum Grade
{
	F,
	D,
	C,
	B,
	A
}

enum Phase
{
	Idle,
	Warmup,
	Active,
	Cooldown,
	Done
}

struct Acc
{
	i32 Sum;
	i32 Count;
	i32 Max;
}

struct Vec3
{
	i32 X;
	i32 Y;
	i32 Z;
}

struct Pair
{
	i32 A;
	i32 B;
}

