	if (score < 18)
	{
		return Grade::F;
	}
	if (score < 29)
	{
		return Grade::D;
	}
	if (score < 33)
	{
		return Grade::C;
	}
	if (score < 81)
	{
		return Grade::B;
	}
	return Grade::A;
}

