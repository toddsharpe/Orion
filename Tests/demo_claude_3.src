	i32 vmres = vm_eval(code, argv);
	WriteLine($"  ((2+3)*4)-5 = {vmres}");
	Assert(vmres == 15);

	WriteLine("[ higher-order ]");
	Func<i32, i32, i32> add = [](i32 a, i32 b)
	{
		return a + b;
	}:i32;
	i32 folded = fold<i32>(data, 0, add);
	WriteLine($"  fold sum of data = {folded}");
	Func<i32, bool> odd = [](i32 x)
	{
		return (x % 2) != 0;
	}:bool;
	WriteLine($"  odd count in data = {count_if<i32>(data, odd)}");

	WriteLine("[ struct arrays ]");
	Vec3[] basis = [Vec3{X=3,Y=0,Z=0}, Vec3{X=0,Y=4,Z=0}, Vec3{X=0,Y=0,Z=5}]:Vec3;
	i32 mag = 0;
	for (i32 i = 0; i < basis.Length; i++)
	{
		Vec3 bv = basis[i];
		mag = (mag + (bv.X * bv.X)) + ((bv.Y * bv.Y) + (bv.Z * bv.Z));
	}
	WriteLine($"  sum |v|^2 = {mag}");
	Assert(mag == 50);

	// Floats (f32/f64) reduced with the generic fold, and a typed i64 literal.
	WriteLine("[ floats + typed literals ]");
	f64[] weights = [0.25, 0.5, 1.25, 2.0]:f64;
	f64 wsum = weights[0];
	for (i32 i = 1; i < weights.Length; i++)
	{
		wsum = wsum + weights[i];
	}
	WriteLine($"  f64 weight sum = {wsum}");
	f32 half = 0.5:f32;
	WriteLine($"  f32 half + half = {half + half}");
	i64 big = 9000000000:i64;
	WriteLine($"  i64 literal = {big}");

