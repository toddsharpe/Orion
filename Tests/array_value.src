// Arrays are VALUES: assigning or returning one copies it. C++ emits std::array (a value) and
// Python copies on assignment; both must agree.
//
// This pins a historical defect, where a sized allocation lowered to a single
// global and every call to an array-returning function handed back the same buffer -- so the second
// call silently overwrote the first call's result, and only in C++.

// A returned array must state its length, so it can be returned by value rather than as a view of
// storage that is gone by the time the caller reads it.
f64[3] make(f64 seed)
{
	f64[3] a;
	a[0] = seed;
	a[1] = seed + 1.0;
	a[2] = seed + 2.0;
	return a;
}

// An unsized parameter is a view (std::span in C++), so ONE function serves every length, and a
// write through it is seen by the caller.
i32 total(ConstSpan<i32> values)
{
	i32 sum = 0;
	for (const i32 v in values)
	{
		sum = sum + v;
	}
	return sum;
}

void bump_first(Span<i32> values)
{
	values[0] = values[0] + 100;
}

i32 main()
{
	// Two calls must not share storage: the second must not disturb the first.
	f64[3] x = make(10.0);
	f64[3] y = make(20.0);
	WriteLine($"x = {x[0]} {x[1]} {x[2]}");
	WriteLine($"y = {y[0]} {y[1]} {y[2]}");

	// Assignment copies: writing through the copy must not touch the original.
	f64[] copy = x;
	copy[0] = 99.0;
	WriteLine($"assign copies: x[0]={x[0]} copy[0]={copy[0]}");

	// One unsized parameter, several lengths.
	i32[] three = [1, 2, 3]:i32;
	i32[] eight = [10, 20, 30, 40, 50, 60, 70, 80]:i32;
	WriteLine($"total(3)={total(three)} total(8)={total(eight)}");
	WriteLine($"lengths: {three.Length} {eight.Length}");

	// A parameter is a view, so a write through it IS visible to the caller.
	bump_first(three);
	WriteLine($"through a view: three[0]={three[0]}");

	return 0;
}
