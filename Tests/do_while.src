// do/while. The body runs before the first test, so it always executes at least once, and `continue`
// lands on the test at the bottom rather than the top of the body. C++ gets a native do/while;
// Python has no such form, so it renders as a loop with the test at the end.

// Runs once even when the condition is false at the first test.
i32 at_least_once(i32 start)
{
	i32 n = start;
	do
	{
		n = n + 1;
	}
	while (n < 5);
	return n;
}

// `continue` jumps to the test (so the loop still advances); `break` leaves it.
i32 evens_upto(i32 limit)
{
	i32 i = 0;
	i32 sum = 0;
	do
	{
		i = i + 1;
		if ((i % 2) == 1)
		{
			continue;
		}
		if (i > limit)
		{
			break;
		}
		sum = sum + i;
	}
	while (i < 20);
	return sum;
}

// Nested, and with the trailing ';' omitted -- the grammar takes it either way.
i32 grid(i32 rows, i32 cols)
{
	i32 r = 0;
	i32 total = 0;
	do
	{
		i32 c = 0;
		do
		{
			total = total + 1;
			c = c + 1;
		}
		while (c < cols)
		r = r + 1;
	}
	while (r < rows)
	return total;
}

// The same loop at build time: this one runs as MSIL in the executor, not in the backend.
#build i32 triangle(i32 n)
{
	i32 i = 0;
	i32 total = 0;
	do
	{
		total = total + i;
		i = i + 1;
	}
	while (i < n);
	return total;
}

void test()
{
	WriteLine("at_least_once(0) = " + to_str(at_least_once(0)));
	WriteLine("at_least_once(9) = " + to_str(at_least_once(9)));
	WriteLine("evens_upto(8) = " + to_str(evens_upto(8)));
	WriteLine("grid(3, 4) = " + to_str(grid(3, 4)));

	i32 folded = #run triangle(5);
	WriteLine("triangle(5) = " + to_str(folded));
}

i32 main()
{
	test();
	return 0;
}
