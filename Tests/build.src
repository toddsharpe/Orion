#build str gen()
{
	return "Hello World: Build";
}

str gen_()
{
	return "Hello World: RT";
}

i32 value()
{
	return 1;
}

#build void array_test()
{
	i32[] ints = [value(), value(), value()]:i32;
	WriteInts(ints);
}

i32 main()
{
	str s = gen_();
	WriteLine(s);

	#run
	{
		//Write build time
		str current = Time::Now();
		WriteLine(current);
	}

	WriteLine(#run gen_());

	#run
	{
		str b1 = gen();
		for (i32 i = 0; i < 5; i++)
		{
			WriteLine(b1);
		}
	}

	#run array_test();

	i32[] ints = [value(), value(), value()]:i32;
	WriteInts(ints);

	return 0;
}
