struct Record
{
	str Name;
	i32 Value;
}

void test1()
{
	Record r2 = Record{ Name="Asd", Value=3};
	r2.Name = "asd2";
	WriteLine("Name: " + r2.Name);
	WriteLine("Value: " + to_str(r2.Value));
}

void test2()
{
	Record r2 = Record{};
	r2.Name = "asd";
	r2.Value = 2;
	WriteLine("Name: " + r2.Name);
	WriteLine("Value: " + to_str(r2.Value));
}

i32 main()
{
	#run test1();
	test1();

	#run test2();
	test2();

	return 0;
}
