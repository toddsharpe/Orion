i32 first_over(ConstSpan<i32> a, i32 threshold)
{
	for (i32 i = 0; i < a.Length; i++)
	{
		if (a[i] > threshold)
		{
			return i;
		}
		if (a[i] == 0)
		{
			break;
		}
	}
	return -1;
}

i32 sum_odds(ConstSpan<i32> a)
{
	i32 s = 0;
	for (i32 i = 0; i < a.Length; i++)
	{
		if ((a[i] % 2) == 0)
		{
			continue;
		}
		s += a[i];
	}
	return s;
}

i32 count_down(i32 n)
{
	i32 steps = 0;
	while (true)
	{
		steps += 1;
		n -= 1;
		if (n <= 0)
		{
			break;
		}
	}
	return steps;
}

i32 nested_find(ConstSpan<i32> a, i32 target)
{
	i32 found = -1;
	for (i32 i = 0; i < a.Length; i++)
	{
		for (i32 j = 0; j < a.Length; j++)
		{
			if ((a[i] + a[j]) == target)
			{
				found = (i * 100) + j;
				break;
			}
		}
		if (found >= 0)
		{
			break;
		}
	}
	return found;
}

void test()
{
	i32[] data = [3, 8, 5, 2, 9, 4]:i32;
	WriteLine("first_over(6) = " + to_str(first_over(data, 6)));
	WriteLine("sum_odds = " + to_str(sum_odds(data)));
	WriteLine("count_down(5) = " + to_str(count_down(5)));
	WriteLine("nested_find(11) = " + to_str(nested_find(data, 11)));
}

i32 main()
{
	#run test();
	test();
	return 0;
}
