#build void BuildDate()
{
	WriteLine(Time::Now());
	return;
}

#build str ReadFile(str file)
{
	str body = "";
	File f = File::Open(file);
	while (File::HasLine(f))
	{
		str l = File::ReadLine(f);
		body = body + l;
	}
	return body;
}

i32 main()
{
	#run BuildDate();

	str b = #run ReadFile("Configs/test.txt");
	WriteLine(b);

	return 0;
}