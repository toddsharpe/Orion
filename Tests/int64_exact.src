//64-bit integers are exact on every backend, past 2^53 included, where a double would round; each value goes through a parameter so it is computed at run time.
i64 mul(i64 a, i64 b) { return a * b; }
i64 add(i64 a, i64 b) { return a + b; }
u64 uadd(u64 a, u64 b) { return a + b; }
u64 udiv(u64 a, u64 b) { return a / b; }
i64 shl(i64 v, i32 n) { return v << n; }
i64 shr(i64 v, i32 n) { return v >> n; }
u64 ushr(u64 v, u8 n) { return v >> n; }
i32 shl32(i32 v, i64 n) { return v << n; }
u64 mix(u64 a, u64 b) { return (a & b) | (a ^ ~b); }
bool less(i64 a, i64 b) { return a < b; }
i32 to32(i64 v) { return cast<i32>(v); }
u64 tou(i64 v) { return cast<u64>(v); }
f64 tof(i64 v) { return cast<f64>(v); }
i64 fromf(f64 v) { return cast<i64>(v); }
i64 from32(i32 v) { return cast<i64>(v); }

i32 main()
{
	i64 big = 3037000499:i64;
	WriteLine($"mul {mul(big, big)}");
	WriteLine($"wrap {add(9223372036854775807:i64, 1:i64)} {uadd(18446744073709551615:u64, 1:u64)}");
	WriteLine($"udiv {udiv(18446744073709551615:u64, 3:u64)}");
	WriteLine($"shift {shl(3:i64, 40)} {shr(-1099511627776:i64, 20)} {ushr(18446744073709551615:u64, 60:u8)} {shl32(1, 5:i64)}");
	WriteLine($"bits {mix(18446744073709551615:u64, 9223372036854775808:u64)}");
	WriteLine($"cast {to32(4294967297:i64)} {from32(-7)} {tou(-1:i64)} {tof(9007199254740993:i64)} {fromf(-2.7)}");
	WriteLine($"compare {less(9007199254740992:i64, 9007199254740993:i64)}");

	i64 count = 9007199254740990:i64;
	for (i32 i = 0; i < 5; i++)
	{
		count++;
	}
	WriteLine($"count {count}");

	u8[8] frame;
	pack_be<i64>(frame, 0:u32, 9007199254740993:i64);
	WriteLine($"frame {bytes_hexstr(frame)} {unpack_be<i64>(frame, 0:u32)}");
	return 0;
}
